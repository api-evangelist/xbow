{
  "opencollection": "1.0.0",
  "info": {
    "name": "XBOW Assessments Findings API",
    "version": "2026-07-01"
  },
  "items": [
    {
      "info": {
        "name": "Findings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List findings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/assets/:assetId/findings",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all findings for an asset.\n\nSupports pagination via `limit` and `after` query parameters."
        },
        {
          "info": {
            "name": "Get finding",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/findings/:findingId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "findingId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a specific finding"
        },
        {
          "info": {
            "name": "Update finding metadata",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://console.xbow.com/api/v1/findings/:findingId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "findingId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates customer-controlled workflow metadata on a finding. Only `externalWorkflowState` and `externalTicketReference` may be set; these are independent of the XBOW-owned lifecycle fields (state, severity, CVSS). Omitted fields are left unchanged; send `null` to clear a field.\n\nAn `externalTicketReference` may only be present alongside an `externalWorkflowState`: the workflow state may be set on its own, but a ticket reference may not. A request whose result would leave a ticket reference withou"
        },
        {
          "info": {
            "name": "Verify fix",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://console.xbow.com/api/v1/findings/:findingId/verify-fix",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "findingId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Request verification that a finding has been mitigated. This will trigger a targeted assessment specifically to verify that the vulnerability has been mitigated. Once XBOW verifies that the finding has been fixed, it will be marked as such."
        }
      ]
    }
  ],
  "bundled": true
}