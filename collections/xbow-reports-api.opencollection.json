{
  "opencollection": "1.0.0",
  "info": {
    "name": "XBOW Assessments Reports API",
    "version": "2026-07-01"
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List asset reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/assets/:assetId/reports",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all available report versions for an asset.\n\nSupports pagination via `limit` and `after` query parameters."
        },
        {
          "info": {
            "name": "Get report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/reports/:reportId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Downloads a report version as a PDF file using its UUID."
        },
        {
          "info": {
            "name": "Get report summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/reports/:reportId/summary",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a summary of a report version using its UUID."
        }
      ]
    }
  ],
  "bundled": true
}