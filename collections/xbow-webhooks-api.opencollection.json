{
  "opencollection": "1.0.0",
  "info": {
    "name": "XBOW Assessments Webhooks API",
    "version": "2026-07-01"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhook subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/organizations/:organizationId/webhooks",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all webhook subscriptions for an organization.\n\nSupports pagination via `limit` and `after` query parameters.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "Create webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://console.xbow.com/api/v1/organizations/:organizationId/webhooks",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new webhook subscription for an organization. Upon completion XBOW will deliver 2 `ping` events, one with a valid and one with an invalid signature.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "Get webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/webhooks/:webhookId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a specific webhook subscription by ID.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "Update webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://console.xbow.com/api/v1/webhooks/:webhookId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an existing webhook subscription.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "Delete webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://console.xbow.com/api/v1/webhooks/:webhookId",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a webhook subscription.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "List webhook subscription deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.xbow.com/api/v1/webhooks/:webhookId/deliveries",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists delivery history for a specific webhook subscription.\n\nSupports pagination via `limit` and `after` query parameters.\n\nRequires an _organization_ API key."
        },
        {
          "info": {
            "name": "Ping webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://console.xbow.com/api/v1/webhooks/:webhookId/ping",
            "headers": [
              {
                "name": "X-XBOW-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Sends a ping event to a webhook subscription to test connectivity.\n\nRequires an _organization_ API key."
        }
      ]
    }
  ],
  "bundled": true
}